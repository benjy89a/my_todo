# .env 로 복사해서 사용 (.env 는 git에 올리지 않기)

# Supabase 대시보드 → Project Settings → API (또는 Connect 버튼)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Publishable key(sb_publishable_...) 또는 legacy "anon public" 키.
# service_role / secret 키는 RLS 를 무시하므로 넣지 마세요.
SUPABASE_PUBLISHABLE_KEY=

PORT=3000
# 로컬은 127.0.0.1, Render 같은 클라우드는 0.0.0.0
HOST=127.0.0.1
# 클라우드(https)에서는 production → 로그인 쿠키에 Secure 붙음
NODE_ENV=development
